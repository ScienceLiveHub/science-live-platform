# Display names (foaf:name) for a set of creator ORCID URIs.
# A constellation's node label, date and creator are captured from the
# reference-discovery queries during the walk; only the human-readable creator
# name still needs a lookup. A constellation has just a handful of distinct
# authors, so this stays a small, fast query.
#
# Placeholder: `?_uris` - RAW: a space-separated list of bracketed ORCID URIs for
#   a SPARQL VALUES body, e.g. "<https://orcid.org/0000-0002-1784-2920> <https://orcid.org/0000-0001-7542-0286>".

prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix dct: <http://purl.org/dc/terms/>
prefix foaf: <http://xmlns.com/foaf/0.1/>

select distinct ?orcid ?name where {
  values ?orcid { ?_uris }
  graph npa:graph {
    ?np dct:creator ?orcid ;
        np:hasPublicationInfo ?pubinfo .
  }
  graph ?pubinfo {
    ?orcid foaf:name ?name .
  }
}
