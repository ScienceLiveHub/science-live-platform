@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  rdf:type rdfs:label "is a" .
  
  rdfs:label rdfs:label "has the name" .
  
  <https://w3id.org/fair/fip/terms/declared-for-digital-object-type> rdfs:label "for specific" .
  
  <https://w3id.org/fff/User-Story> rdfs:label "user story" .
  
  <https://w3id.org/fff/as-a> rdfs:label "As a" .
  
  <https://w3id.org/fff/covers-domain> rdfs:label "covers domain" .
  
  <https://w3id.org/fff/exposed-entity> rdfs:label "exposed entity" .
  
  <https://w3id.org/fff/faces-challenge> rdfs:label "faces challenge" .
  
  <https://w3id.org/fff/i-want-to> rdfs:label "I want to" .
  
  <https://w3id.org/fff/so-that> rdfs:label "so that" .
  
  sub:DO a nt:GuidedChoicePlaceholder;
    rdfs:label "digital object type";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAom4OoQ8U2K6A629YRXKo9-XU-ZJM7-KZs1h11OD6c1w/find-things?type=https://w3id.org/fair/fip/terms/Digital-Object-Type" .
  
  sub:US a nt:IntroducedResource, nt:LocalResource, nt:UriPlaceholder .
  
  sub:action a nt:LiteralPlaceholder;
    rdfs:label "activity" .
  
  sub:challenge a nt:GuidedChoicePlaceholder;
    rdfs:label "risk";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAom4OoQ8U2K6A629YRXKo9-XU-ZJM7-KZs1h11OD6c1w/find-things?type=https://w3id.org/fff/Challenge" .
  
  sub:domain a nt:RestrictedChoicePlaceholder;
    rdfs:label "domain";
    nt:possibleValuesFrom <https://w3id.org/np/RADj5kIS6YAzoRyzVfiuV97Kla8U5rkU6sMTsbkYVjBUI> .
  
  sub:exposed a nt:GuidedChoicePlaceholder;
    rdfs:label "sector exposed";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAom4OoQ8U2K6A629YRXKo9-XU-ZJM7-KZs1h11OD6c1w/find-things?type=https://w3id.org/fff/Exposed-Entity" .
  
  sub:label a nt:LiteralPlaceholder .
  
  sub:purpose a nt:LiteralPlaceholder;
    rdfs:label "purpose" .
  
  sub:short-name-of-user-story a nt:AssertionTemplate;
    dct:description "Describes a User Story.";
    rdfs:label "User Story";
    nt:hasNanopubLabelPattern "${label}";
    nt:hasStatement sub:st01, sub:st02, sub:st03, sub:st04, sub:st05, sub:st06, sub:st07,
      sub:st08, sub:st09;
    nt:hasTag "Requirements Elicitation";
    nt:hasTargetNanopubType <https://schema.org/FundingScheme> .
  
  sub:st01 rdf:object <https://w3id.org/fff/User-Story>;
    rdf:predicate rdf:type;
    rdf:subject sub:US .
  
  sub:st02 rdf:object sub:label;
    rdf:predicate rdfs:label;
    rdf:subject sub:US .
  
  sub:st03 a nt:RepeatableStatement;
    rdf:object sub:domain;
    rdf:predicate <https://w3id.org/fff/covers-domain>;
    rdf:subject sub:US .
  
  sub:st04 a nt:RepeatableStatement;
    rdf:object sub:challenge;
    rdf:predicate <https://w3id.org/fff/faces-challenge>;
    rdf:subject sub:US .
  
  sub:st05 a nt:RepeatableStatement;
    rdf:object sub:exposed;
    rdf:predicate <https://w3id.org/fff/exposed-entity>;
    rdf:subject sub:US .
  
  sub:st06 rdf:object sub:user;
    rdf:predicate <https://w3id.org/fff/as-a>;
    rdf:subject sub:US .
  
  sub:st07 rdf:object sub:action;
    rdf:predicate <https://w3id.org/fff/i-want-to>;
    rdf:subject sub:US .
  
  sub:st08 rdf:object sub:purpose;
    rdf:predicate <https://w3id.org/fff/so-that>;
    rdf:subject sub:US .
  
  sub:st09 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:DO;
    rdf:predicate <https://w3id.org/fair/fip/terms/declared-for-digital-object-type>;
    rdf:subject sub:US .
  
  sub:user a nt:LiteralPlaceholder;
    rdfs:label "user" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0009-0007-7713-900X .
}

